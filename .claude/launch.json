{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "horizon-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "horizon-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "demo",
        "--port",
        "1421"
      ],
      "port": 1421
    },
    {
      "name": "horizon-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "1422",
        "--strictPort"
      ],
      "port": 1422
    }
  ]
}
