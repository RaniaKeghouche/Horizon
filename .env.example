# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
#
# With no Supabase URL / key the app runs in DEMO MODE: everything lives in a
# local store pre-filled with sample data, so it can be tried with no backend.

# ---- Supabase (Postgres + Auth + Realtime) ----------------------------------
# Use the public anon key only, never the service_role key: every VITE_*
# variable ends up in the code sent to the browser. Data is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The e-mail address that becomes the administrator on first sign-in.
VITE_OWNER_EMAIL=

# ---- Optional ----------------------------------------------------------------
# Google Sheets backup: URL of the Apps Script web app
# (see supabase/google-sheet-appsscript.gs).
VITE_SHEET_WEBHOOK_URL=

# EmailJS: confirmation code and accepted / refused e-mails.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CODE=
VITE_EMAILJS_TEMPLATE_DECISION=

# ---- School details shown in the app (defaults live in src/lib/school.ts) ----
# An empty value hides the matching line on the contact card.
VITE_SCHOOL_NAME=Horizon Skills Academy
VITE_SCHOOL_CITY=Constantine
VITE_SCHOOL_ADDRESS=
VITE_SCHOOL_PLUS_CODE=
VITE_SCHOOL_PHONE=
VITE_SCHOOL_PHONE_E164=
VITE_SCHOOL_EMAIL=
VITE_SCHOOL_WHATSAPP=
VITE_SCHOOL_COORDS=
VITE_SCHOOL_MAPS=
