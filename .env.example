# Firebase — copy this file to `.env` and fill with your project's values.
# Get them from Firebase Console > Project settings > Your apps > Web app config.
# NEVER commit the real .env file (it's git-ignored).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# E-mail qui devient administrateur (propriétaire) à l'inscription.
VITE_OWNER_EMAIL=

# ---- Coordonnees de l'ecole (src/lib/school.ts) -----------------------------
# Elles ont des valeurs par defaut dans le code : ces variables ne servent qu'a
# les remplacer sans toucher aux sources. Une valeur vide retire la ligne
# correspondante de la carte de contact.
VITE_SCHOOL_NAME=Horizon Skills Academy
VITE_SCHOOL_CITY=Constantine
VITE_SCHOOL_ADDRESS=
VITE_SCHOOL_PLUS_CODE=
# Affiche tel quel ; VITE_SCHOOL_PHONE_E164 sert aux liens tel: et wa.me.
VITE_SCHOOL_PHONE=
VITE_SCHOOL_PHONE_E164=
VITE_SCHOOL_EMAIL=
# Par defaut, le meme numero que la ligne fixe. Vide = pas de ligne WhatsApp.
VITE_SCHOOL_WHATSAPP=
# Coordonnees exactes (latitude,longitude) : le repere de la carte.
VITE_SCHOOL_COORDS=
# Lien de carte force ; sinon il est construit depuis les coordonnees.
VITE_SCHOOL_MAPS=
