rules_version = '2';
// Role-Based Access Control (Cahier des Charges §9).
// Admin: full access. Teacher: own classes/students. Student: own data (read-only).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }
    function isTeacher() {
      return isSignedIn() && role() == 'teacher';
    }

    // A user can always read their own profile; only admin manages roles.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Admin manages the whole school; teachers read to build their views.
    match /students/{doc} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }
    match /teachers/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /subjects/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /classes/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /enrollments/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teachers mark attendance / write session notes; students read only.
    match /sessions/{doc} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // Payments are admin-only for writes; students/parents read their own.
    match /payments/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notifications: readable by their owner; system/admin writes them.
    match /notifications/{doc} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // Teachers can create slot requests; admin approves/rejects.
    match /slotRequests/{doc} {
      allow read: if isSignedIn();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Audit trail — append-only, admin reads.
    match /activityLog/{doc} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
